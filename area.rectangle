#include <stdio.h>

int  main() {
float length,width;
const float Two=2.0;
float area,perimeter;
  
    printf("Enter length");
scanf("%f",&length);

printf("Enter width");
scanf("%f",&width);

area=length*width; 
perimeter=Two*(length+width);

printf("length=%.2f\n",length);
printf("width=%.2f\n",width);

printf("Area=%.2f\n",area);
printf("perimeter=%.2f\n",perimeter);
    return 0;
}
    